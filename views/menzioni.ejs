<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menzioni</title>

    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/menzioniCSS.css">

</head>

<body class="container mt-5">
<h1 class="mb-4">Lista Menzioni</h1>

<ul class="list-group" id="friendList">
    <% for (const menzionante of menzionanti) { %>
        <li class="list-group-item">
            <p><%= menzionante %> ti ha menzionato in uno Squeal</p>
        </li>
    <% } %>
</ul>

<% if (menzionanti.length === 0) { %>
    <p class="mt-3 nex">Nessuna menzione trovata.</p>
<% } %>

<div class="form-group createButton-container d-flex">
    <button type="submit" class="btn btn-primary view mr-2" onclick="viewMenzioni()">View</button>
    <a href="/" class="btn btn-secondary ml-2">Home</a>
</div>
</form>

<script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>

<script>
    function viewMenzioni() {
        window.location.href = "/viewMenzioni";
    }
</script>
</body>
</html>
