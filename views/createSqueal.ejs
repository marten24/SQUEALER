<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Squeal</title>

    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/createSquealCSS.css">

</head>
<body class="container mt-5">

<h1 class="mb-4">Crea un nuovo Squeal</h1>
<% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert">
        <%= errorMessage %>
    </div>
<% } %>

<div class="button-container">
    <button class="btn btn-light type-button" data-type="text">Text</button>
    <button class="btn btn-light type-button" data-type="photo">Image</button>
    <button class="btn btn-light type-button" data-type="video">Video</button>
    <button class="btn btn-light type-button" data-type="luogo">Location</button>
    <div class="form-group select">
        <label for="selectOption"></label>
        <select class="form-control" id="selectOption" name="selectOption">
            <option value="choose" selected>Scegli a chi mandare lo squeal</option>
            <option id="user" value="user">Invia ad un amico</option>
            <option id= "channel" value="channel">Invia nel canale</option>
        </select>
    </div>
</div>

<form action="/createSqueal" class="mt-3" id="form">
    <div class="form-group friends-select mx-auto text-center">
        <label for="friendsSelect"></label>
        <select class="form-control" id="friendsSelect" name="selectedFriend">
            <% for (const friend of friendsUsername) { %>
                <option value="<%= friend.amico %>"><%= friend.amico %></option>
            <% } %>
        </select>
    </div>

    <div class="form-group channels mx-auto text-center">
        <label for="channels"></label>
        <select class="form-control" id="channels" name="channels">
            <% for (const nomeCanaleArray of nomiCanali) { %>
                <% for (const nomeCanale of nomeCanaleArray) { %>
                    <option value="<%= nomeCanale %>"><%= nomeCanale %></option>
                <% } %>
            <% } %>
        </select>
    </div>

    <div class="form-group textInput-container">
        <label for="inputText"></label>
        <input type="text" class="form-control" id="inputText" name="testo" >
    </div>

    <div class="form-group fotoInput-container">
        <label for="inputFoto"></label>
        <input type="text" class="form-control" id="inputFoto" name="media" >
    </div>

    <div class="form-group videoInput-container">
        <label for="inputVideo"></label>
        <input type="text" class="form-control" id="inputVideo" name="video" >
    </div>

    <div class="form-group mapInput-container">
        <label for="inputMap"></label>
        <input type="text" class="form-control" id="inputMap" name="inputMap" >
    </div>

    <div class="caratteri">
        <p id="quotaGiornaliera"> Ti rimangono solo: <%= quotaGiornaliera %> caratteri giornalieri </p>
        <p id="quotaSettimanale"> <%= quotaSettimanale %> caratteri settimanali </p>
        <p id="quotaMensile"> <%= quotaMensile %> caratteri mensili </p>
    </div>

    <div class="form-group createButton-container d-flex">
        <button type="submit" class="btn btn-primary create-squeal mr-2">Send</button>
        <a href="/" class="btn btn-secondary home mx-2">Home</a>
        <a href="/acquistaCaratteri" class="btn btn-secondary shop ml-2">Buy</a>
    </div>
</form>

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script type= "application/javascript" src="/createSquealJS.js"></script>

</body>
</html>